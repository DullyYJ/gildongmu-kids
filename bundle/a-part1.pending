=== FILE: app/src/main/java/com/dullyyj/kids/Core.java ===
package com.dullyyj.kids;

import android.content.Context;

/** 앱 전체가 함께 쓰는 단일 객체들. */
final class Core {
    static Store store;
    static Engine engine;
    static Sheets sheets;

    private Core() {}

    static synchronized void init(Context app) {
        if (store != null) return;
        store = new Store(app);
        engine = new Engine(store);
        sheets = new Sheets(app);
    }
}
=== FILE: app/src/main/java/com/dullyyj/kids/Store.java ===
package com.dullyyj.kids;

import android.content.Context;
import android.content.SharedPreferences;

/** 기기에 저장하는 작은 값들(엔진 상태 포함). */
final class Store {
    private final SharedPreferences sp;

    Store(Context c) {
        sp = c.getSharedPreferences("kids", Context.MODE_PRIVATE);
    }

    synchronized String get(String k, String d) {
        return sp.getString(k, d);
    }

    synchronized void put(String k, String v) {
        sp.edit().putString(k, v).apply();
    }

    synchronized long getLong(String k, long d) {
        try {
            return Long.parseLong(sp.getString(k, String.valueOf(d)));
        } catch (Exception e) {
            return d;
        }
    }

    synchronized void putLong(String k, long v) {
        put(k, String.valueOf(v));
    }

    synchronized boolean has(String k) {
        return sp.contains(k);
    }
}
=== FILE: app/src/main/java/com/dullyyj/kids/Pal.java ===
package com.dullyyj.kids;

/** 색 역할 14개 — 길동무 ShellCore.palette 와 같은 값·같은 순서. 테마 이름도 같다(dark / pastel). */
final class Pal {
    static final int BG = 0, CARD = 1, BORDER = 2, TEXT = 3, SUB = 4, GOLD = 5, ORANGE = 6, IMGBG = 7,
            WHITE = 8, BORDER2 = 9, CARD2 = 10, NAV = 11, GOLD2 = 12, ONGOLD = 13;

    static final int[] DARK = {
        0xFF121214, 0xFF1C1C1E, 0xFF2C2C2E, 0xFFF2F2F7, 0xFF8E8E93, 0xFFD4AF37, 0xFFFF9F0A,
        0xFF252528, 0xFFFFFFFF, 0xFF3A3A3C, 0xFF2C2C2E, 0xFF1C1C1E, 0xFFB8922F, 0xFF121214
    };
    static final int[] PASTEL = {
        0xFFF0F4F8, 0xFFFFFFFF, 0xFFDCE8F0, 0xFF1A2533, 0xFF6B8299, 0xFF1D9BF0, 0xFFF07830,
        0xFFE8F4FF, 0xFFFFFFFF, 0xFFC8DCEA, 0xFFE8F0F8, 0xFFFFFFFF, 0xFF0E7DD6, 0xFFFFFFFF
    };

    static int[] cur = PASTEL;
    static boolean dark = false;

    private Pal() {}

    static void set(String theme) {
        dark = "dark".equals(theme);
        cur = dark ? DARK : PASTEL;
    }

    static int c(int role) {
        return cur[role];
    }
}
=== FILE: app/src/main/java/com/dullyyj/kids/Ui.java ===
package com.dullyyj.kids;

import android.content.Context;
import android.graphics.drawable.GradientDrawable;
import android.graphics.Typeface;
import android.util.TypedValue;
import android.widget.TextView;

final class Ui {
    private Ui() {}

    static float dp(Context c, float v) {
        return v * c.getResources().getDisplayMetrics().density;
    }

    static int dpi(Context c, float v) {
        return Math.round(dp(c, v));
    }

    static GradientDrawable box(Context c, int fill, float radiusDp, int stroke) {
        GradientDrawable g = new GradientDrawable();
        g.setColor(fill);
        g.setCornerRadius(dp(c, radiusDp));
        if (stroke != 0) g.setStroke(Math.max(1, Math.round(dp(c, 1f))), stroke);
        return g;
    }

    static TextView text(Context c, String s, float sp, int color, boolean bold) {
        TextView t = new TextView(c);
        t.setText(s);
        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
        t.setTextColor(color);
        t.setTypeface(bold ? Typeface.DEFAULT_BOLD : Typeface.DEFAULT);
        t.setLineSpacing(0f, 1.15f);
        return t;
    }
}
=== FILE: app/src/main/java/com/dullyyj/kids/Sheets.java ===
package com.dullyyj.kids;

import android.content.Context;
import android.graphics.Bitmap;
import android.graphics.BitmapFactory;
import android.os.Handler;
import android.os.Looper;
import android.util.LruCache;

import java.io.InputStream;
import java.util.HashSet;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;

/** 길동무 3D 캐릭터 프레임 시트(assets/chars3d/*.webp, 4x4칸)를 백그라운드에서 읽어 둔다. 메인 스레드는 읽지 않는다. */
final class Sheets {
    private final Context ctx;
    private final LruCache<String, Bitmap> cache = new LruCache<String, Bitmap>(80 * 1024 * 1024) {
        @Override
        protected int sizeOf(String k, Bitmap b) {
            return b.getByteCount();
        }
    };
    private final HashSet<String> loading = new HashSet<String>();
    private final HashSet<String> missing = new HashSet<String>();
    private final ExecutorService ex = Executors.newFixedThreadPool(2);
    private final Handler main = new Handler(Looper.getMainLooper());

    Sheets(Context c) {
        ctx = c.getApplicationContext();
    }

    static String walkFile(String id) {
        return "bbosong".equals(id) ? "bbosong_0" : id;
    }

    static String actFile(String id) {
        return "bbosong".equals(id) ? "bbosong_0_act" : id + "_act";
    }

    /** 읽혀 있으면 바로 돌려주고, 아니면 null 을 주고 뒤에서 읽은 다음 done 을 메인 스레드에서 부른다. */
    Bitmap get(final String file, final Runnable done) {
        Bitmap b = cache.get(file);
        if (b != null) return b;
        synchronized (this) {
            if (missing.contains(file) || loading.contains(file)) return null;
            loading.add(file);
        }
        ex.execute(new Runnable() {
            @Override
            public void run() {
                Bitmap r = null;
                try {
                    InputStream in = ctx.getAssets().open("chars3d/" + file + ".webp");
                    try {
                        r = BitmapFactory.decodeStream(in);
                    } finally {
                        in.close();
                    }
                } catch (Throwable t) {
                    r = null;
                }
                synchronized (Sheets.this) {
                    loading.remove(file);
                    if (r == null) missing.add(file);
                }
                if (r != null) {
                    cache.put(file, r);
                    if (done != null) main.post(done);
                }
            }
        });
        return null;
    }
}
=== FILE: app/src/main/java/com/dullyyj/kids/ThumbView.java ===
package com.dullyyj.kids;

import android.content.Context;
import android.graphics.Bitmap;
import android.graphics.Canvas;
import android.graphics.Paint;
import android.graphics.Rect;
import android.graphics.RectF;
import android.view.View;

/** 홈 브리핑 카드의 작은 얼굴 — 걷기 시트 첫 칸. */
final class ThumbView extends View {
    private final String file;
    private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG | Paint.FILTER_BITMAP_FLAG);
    private final Rect src = new Rect();
    private final RectF dst = new RectF();
    private final Runnable inv = new Runnable() {
        @Override
        public void run() {
            invalidate();
        }
    };

    ThumbView(Context c, String file) {
        super(c);
        this.file = file;
    }

    @Override
    protected void onDraw(Canvas c) {
        float w = getWidth(), h = getHeight(), s = Math.min(w, h);
        Bitmap b = Core.sheets.get(file, inv);
        if (b == null) {
            p.setColor(Pal.c(Pal.IMGBG));
            c.drawCircle(w / 2f, h / 2f, s / 2f, p);
            return;
        }
        int cs = b.getWidth() / 4;
        src.set(0, 0, cs, cs);
        dst.set((w - s) / 2f, (h - s) / 2f, (w + s) / 2f, (h + s) / 2f);
        c.drawBitmap(b, src, dst, p);
    }
}
=== FILE: app/src/main/java/com/dullyyj/kids/TabBar.java ===
package com.dullyyj.kids;

import android.content.Context;
import android.graphics.Canvas;
import android.graphics.Paint;
import android.graphics.Path;
import android.view.MotionEvent;
import android.view.View;

import androidx.core.graphics.PathParser;

import org.json.JSONArray;
import org.json.JSONObject;

import java.util.ArrayList;

/** 하단 탭 막대 — 엔진이 내려준 탭 목록(글자·아이콘 경로·켜진 칸)을 그리기만 한다. */
final class TabBar extends View {
    interface Cb {
        void tab(String id);
    }

    private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
    private final ArrayList<String> ids = new ArrayList<String>();
    private final ArrayList<String> labels = new ArrayList<String>();
    private final ArrayList<Path> paths = new ArrayList<Path>();
    private final ArrayList<Boolean> ons = new ArrayList<Boolean>();
    private Cb cb;

    TabBar(Context c) {
        super(c);
    }

    int count() {
        return ids.size();
    }

    void set(String json, Cb cb) {
        this.cb = cb;
        ids.clear();
        labels.clear();
        paths.clear();
        ons.clear();
        try {
            JSONArray a = new JSONObject(json).optJSONArray("tabs");
            if (a != null) {
                for (int i = 0; i < a.length(); i++) {
                    JSONObject t = a.optJSONObject(i);
                    if (t == null) continue;
                    ids.add(t.optString("id"));
                    labels.add(t.optString("label"));
                    ons.add(t.optInt("on") == 1);
                    Path pa = null;
                    try {
                        pa = PathParser.createPathFromPathData(t.optString("icon"));
                    } catch (Throwable e) {
                        pa = null;
                    }
                    paths.add(pa);
                }
            }
        } catch (Exception e) {
            // 잘못된 화면은 그리지 않는다
        }
        invalidate();
    }

    private float dp(float v) {
        return v * getResources().getDisplayMetrics().density;
    }

    @Override
    protected void onMeasure(int w, int h) {
        setMeasuredDimension(MeasureSpec.getSize(w), Math.round(dp(58f)));
    }

    @Override
    protected void onDraw(Canvas c) {
        int w = getWidth(), h = getHeight();
        p.setStyle(Paint.Style.FILL);
        p.setColor(Pal.c(Pal.NAV));
        c.drawRect(0, 0, w, h, p);
        p.setColor(Pal.c(Pal.BORDER));
        c.drawRect(0, 0, w, Math.max(1f, dp(0.6f)), p);
        int n = ids.size();
        if (n == 0) return;
        float cw = w / (float) n, ic = dp(24f);
        for (int i = 0; i < n; i++) {
            boolean on = ons.get(i);
            int col = on ? Pal.c(Pal.GOLD) : Pal.c(Pal.SUB);
            float cx = cw * (i + 0.5f);
            Path pa = paths.get(i);
            p.setColor(col);
            p.setStyle(Paint.Style.FILL);
            if (pa != null) {
                c.save();
                c.translate(cx - ic / 2f, dp(8f));
                c.scale(ic / 24f, ic / 24f);
                c.drawPath(pa, p);
                c.restore();
            }
            p.setTextAlign(Paint.Align.CENTER);
            p.setTextSize(dp(10.5f));
            p.setFakeBoldText(on);
            c.drawText(labels.get(i), cx, dp(48f), p);
            p.setFakeBoldText(false);
        }
    }

    @Override
    public boolean onTouchEvent(MotionEvent e) {
        if (e.getAction() == MotionEvent.ACTION_DOWN) return ids.size() > 0;
        if (e.getAction() == MotionEvent.ACTION_UP && ids.size() > 0 && cb != null) {
            int i = (int) (e.getX() / (getWidth() / (float) ids.size()));
            if (i >= 0 && i < ids.size()) cb.tab(ids.get(i));
            return true;
        }
        return true;
    }
}
=== FILE: app/src/main/java/com/dullyyj/kids/Net.java ===
package com.dullyyj.kids;

import java.io.OutputStream;
import java.net.HttpURLConnection;
import java.net.URL;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;

/** 서버(워커) 호출. 서버 주소(api)가 비어 있으면 아무것도 보내지 않는다(서버 연결 전). */
final class Net {
    private static final ExecutorService EX = Executors.newSingleThreadExecutor();

    private Net() {}

    static void postLoc(final double lat, final double lng, final float acc, final long ts) {
        final String base = Core.store.get("api", "");
        if (base == null || base.isEmpty()) return;
        EX.execute(new Runnable() {
            @Override
            public void run() {
                HttpURLConnection c = null;
                try {
                    URL u = new URL(base + "/kid/loc");
                    c = (HttpURLConnection) u.openConnection();
                    c.setRequestMethod("POST");
                    c.setConnectTimeout(8000);
                    c.setReadTimeout(8000);
                    c.setDoOutput(true);
                    c.setRequestProperty("Content-Type", "application/json");
                    String body = "{\"cid\":\"" + Core.engine.childId() + "\",\"sec\":\"" + Core.engine.childSecret()
                            + "\",\"lat\":" + lat + ",\"lng\":" + lng + ",\"acc\":" + acc + ",\"ts\":" + ts + "}";
                    OutputStream os = c.getOutputStream();
                    os.write(body.getBytes("UTF-8"));
                    os.close();
                    c.getResponseCode();
                } catch (Throwable t) {
                    // 다음 주기에 다시 보낸다
                } finally {
                    if (c != null) c.disconnect();
                }
            }
        });
    }
}
=== FILE: app/src/main/java/com/dullyyj/kids/LocationService.java ===
package com.dullyyj.kids;

import android.Manifest;
import android.app.Notification;
import android.app.NotificationChannel;
import android.app.NotificationManager;
import android.app.Service;
import android.content.Intent;
import android.content.pm.PackageManager;
import android.content.pm.ServiceInfo;
import android.location.Location;
import android.os.Build;
import android.os.HandlerThread;
import android.os.IBinder;

import com.google.android.gms.location.FusedLocationProviderClient;
import com.google.android.gms.location.LocationCallback;
import com.google.android.gms.location.LocationRequest;
import com.google.android.gms.location.LocationResult;
import com.google.android.gms.location.LocationServices;
import com.google.android.gms.location.Priority;

/** 위치 공유: 앞쪽 서비스 + FusedLocationProvider. 전송 주기는 엔진이 정한다. 위치를 읽는 일은 전부 백그라운드 스레드에서 한다. */
public class LocationService extends Service {
    private FusedLocationProviderClient client;
    private LocationCallback cb;
    private HandlerThread ht;

    @Override
    public IBinder onBind(Intent i) {
        return null;
    }

    @Override
    public int onStartCommand(Intent i, int flags, int startId) {
        Core.init(getApplicationContext());
        NotificationManager nm = getSystemService(NotificationManager.class);
        nm.createNotificationChannel(new NotificationChannel("loc", "위치 공유", NotificationManager.IMPORTANCE_LOW));
        Notification n = new Notification.Builder(this, "loc")
                .setSmallIcon(android.R.drawable.ic_menu_mylocation)
                .setContentTitle("길동무 키즈")
                .setContentText("부모님께 내 위치를 알려주는 중이에요")
                .setOngoing(true)
                .build();
        if (Build.VERSION.SDK_INT >= 29) {
            startForeground(11, n, ServiceInfo.FOREGROUND_SERVICE_TYPE_LOCATION);
        } else {
            startForeground(11, n);
        }
        begin();
        return START_STICKY;
    }

    private void begin() {
        if (cb != null) return;
        if (checkSelfPermission(Manifest.permission.ACCESS_FINE_LOCATION) != PackageManager.PERMISSION_GRANTED) {
            stopSelf();
            return;
        }
        ht = new HandlerThread("kids-loc");
        ht.start();
        client = LocationServices.getFusedLocationProviderClient(this);
        long iv = Core.engine.locIntervalMs();
        LocationRequest req = new LocationRequest.Builder(Priority.PRIORITY_BALANCED_POWER_ACCURACY, iv)
                .setMinUpdateIntervalMillis(iv / 2L)
                .build();
        cb = new LocationCallback() {
            @Override
            public void onLocationResult(LocationResult r) {
                Location l = r.getLastLocation();
                if (l == null) return;
                Core.engine.lastFix(l.getLatitude(), l.getLongitude(), l.getAccuracy(), System.currentTimeMillis());
                Net.postLoc(l.getLatitude(), l.getLongitude(), l.getAccuracy(), l.getTime());
            }
        };
        try {
            client.requestLocationUpdates(req, cb, ht.getLooper());
        } catch (SecurityException e) {
            stopSelf();
        }
    }

    @Override
    public void onDestroy() {
        try {
            if (client != null && cb != null) client.removeLocationUpdates(cb);
        } catch (Throwable t) {
            // 이미 끝남
        }
        cb = null;
        if (ht != null) ht.quitSafely();
        super.onDestroy();
    }
}
